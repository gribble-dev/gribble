{
	"name": "@gribble/core",
	"version": "0.2.1",
	"description": "Gribble core: pi-based audit harness, tool packs, config and flow parsing, report schema.",
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/gribble-dev/gribble",
		"directory": "packages/core"
	},
	"homepage": "https://gribble.dev",
	"engines": {
		"node": ">=22"
	},
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"docs:rules": "node --import tsx/esm scripts/generate-rules-docs.ts"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "catalog:",
		"@earendil-works/pi-ai": "catalog:",
		"@earendil-works/pi-coding-agent": "catalog:",
		"typebox": "catalog:",
		"yaml": "catalog:",
		"playwright": "catalog:",
		"lighthouse": "13.4.1",
		"@axe-core/playwright": "4.13.0",
		"pixelmatch": "7.2.0",
		"pngjs": "7.0.0",
		"sharp": "0.35.4",
		"minimatch": "10.2.6",
		"fast-glob": "3.3.3"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"tsdown": "catalog:",
		"tsx": "^4.20.0",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"@types/pngjs": "^6.0.5"
	}
}
