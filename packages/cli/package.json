{
	"name": "gribble",
	"version": "0.3.0",
	"description": "Tiny bugs that find your bugs before you ship. AI-driven website quality audits for the development phase.",
	"license": "MIT",
	"type": "module",
	"keywords": [
		"audit",
		"qa",
		"seo",
		"accessibility",
		"lighthouse",
		"playwright",
		"ai",
		"agent",
		"ci"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/gribble-dev/gribble",
		"directory": "packages/cli"
	},
	"homepage": "https://gribble.dev",
	"engines": {
		"node": ">=22"
	},
	"bin": {
		"gribble": "./dist/bin.js"
	},
	"files": [
		"dist",
		"docs",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"prepack": "node scripts/copy-docs.mjs"
	},
	"dependencies": {
		"@gribble/core": "workspace:*",
		"@gribble/skills": "workspace:*",
		"@clack/prompts": "1.8.0",
		"commander": "15.0.0",
		"picocolors": "catalog:",
		"playwright": "catalog:",
		"yaml": "catalog:"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "catalog:",
		"@earendil-works/pi-coding-agent": "catalog:"
	},
	"peerDependenciesMeta": {
		"@earendil-works/pi-ai": {
			"optional": true
		},
		"@earendil-works/pi-coding-agent": {
			"optional": true
		}
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "catalog:",
		"@earendil-works/pi-coding-agent": "catalog:",
		"@types/node": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
